   "source": [
    "# To Find Largest Of Three Numbers\n",
    "\n",
    "Num1=float(input(\"Enter 1st number:\"))\n",
    "Num2=float(input(\"Enter 2nd number:\"))\n",
    "Num3=float(input(\"Enter 3rd number:\"))\n",
    "if Num3<Num1>Num2:\n",
    "    Largest=Num1\n",
    "elif Num1<Num2>Num3:\n",
    "    Largest=Num2\n",
    "else: \n",
    "    Largest=Num3\n",
    "print(\"Largest number:\",Largest)"
   ]
